platform "蓝鹰01" blue_adv_fighter_1
   side blue
   position 26.2n 120.5e altitude 9000 m
   heading 90 deg
   route
      position 26.2n 120.5e altitude 9000 m
         speed 550 kts
      position 26n 122e altitude 9000 m
         speed 550 kts
      position 25n 122.5e altitude 9000 m
         speed 550 kts
      position 24.5n 121e altitude 9000 m
         speed 550 kts
      position 25.5n 120e altitude 9000 m
         speed 550 kts
      position 26.2n 120.5e altitude 9000 m
         speed 550 kts
   end_route
   add sensor geo_sensor WSF_GEOMETRIC_SENSOR
      azimuth_field_of_view -180.0 degrees 180.0 degrees
      elevation_field_of_view -90.0 degrees 90.0 degrees
      minimum_range 0 m
      maximum_range 200000 m
      on
      frame_time 1.0 sec
      reports_location
      reports_velocity
      reports_iff
      track_quality 1.0
      ignore_same_side
      internal_link track_manager
   end_sensor
   add processor task_mgr WSF_TASK_PROCESSOR
   end_processor
   add processor engage_mgr WSF_SCRIPT_PROCESSOR
      update_interval 2 sec
      script_variables
         Set<string> engaged = Set<string>();
         bool missionAssigned = false;
         bool missionDone = false;
         WsfTrackId missionTrackId = WsfTrackId();
      end_script_variables
      on_update
         WsfTaskManager task_mgr = (WsfTaskManager)PLATFORM.Processor("task_mgr");
         if (!missionAssigned && task_mgr.IsValid())
         {
            WsfTrack selfTrack = PLATFORM.MakeTrack();
            if (task_mgr.AssignTask(selfTrack, "cap"))
            {
               missionAssigned = true;
               missionTrackId = selfTrack.TrackId();
               writeln(PLATFORM.Name(), " task assigned: cap");
            }
         }
         foreach (WsfLocalTrack track in PLATFORM.MasterTrackList())
         {
            if (!track.IsValid()) { continue; }
            if (track.Side() == PLATFORM.Side()) { continue; }
            if (engaged.Exists(track.TargetName())) { continue; }
            double range = PLATFORM.SlantRangeTo(track);
            if (range < 60000.0)
            {
               WsfWeapon wpn = PLATFORM.Weapon("int_missile");
               if (wpn.IsValid() && wpn.QuantityRemaining() > 0)
               {
                  if (wpn.FireSalvo(track, 1))
                  {
                     engaged.Insert(track.TargetName());
                     writeln(PLATFORM.Name(), " engaging ", track.TargetName(), " at range ", range);
                  }
               }
            }
         }
         if (missionAssigned && !missionDone && engaged.Size() >= 2 && task_mgr.IsValid())
         {
            if (task_mgr.TaskComplete(missionTrackId, "cap"))
            {
               missionDone = true;
               writeln(PLATFORM.Name(), " task complete: cap");
            }
         }
      end_on_update
   end_processor
end_platform

