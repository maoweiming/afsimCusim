define_path_variable CASE east_sea_campaign
file_path .
file_path ../../AFSim/afsim-2.9.0-win64/demos/simple_scenario
file_path ../../AFSim/afsim-2.9.0-win64/demos/base_types

include event_pipe.txt
include event_output.txt
include terrain.txt

log_file ../output/$(CASE).log
event_output file ../output/$(CASE).evt end_event_output
event_pipe file ../output/$(CASE).aer end_event_pipe

event_gateway
   enabled true
   event_pipe_name afsim_events
   control_pipe_name afsim_control
   mover_throttle 0.5 sec
end_event_gateway

include_once platforms/blue_adv_fighter_1_noripr.txt
include_once platforms/red_adv_fighter_1_noripr.txt
include_once platforms/red_multirole_fighter_2_noripr.txt
include_once platforms/awacs.txt

platform "蓝鹰01" blue_adv_fighter_1
   side blue
   category fighter
   route
      position 26.2n 120.5e altitude 9000 m
         speed 550 kts
      position 26n 122e altitude 9000 m
         speed 550 kts
      position 25n 122.5e altitude 9000 m
         speed 550 kts
      position 24.5n 121e altitude 9000 m
         speed 550 kts
      position 25.5n 120e altitude 9000 m
         speed 550 kts
      position 26.2n 120.5e altitude 9000 m
         speed 550 kts
   end_route
   heading 90 deg
end_platform

